# Terraform state — NEVER commit these
*.tfstate
*.tfstate.backup

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Sensitive variable files
*.tfvars.local
*.auto.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json